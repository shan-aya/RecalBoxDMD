# Preferences utilisateur locales de l'outil Windows (IP Recalbox, theme,
# langue...) -- personnelles a chaque poste, ne doivent jamais etre commitees
# ni partagees avec un autre utilisateur du tool.
tools/RecalBoxDMD_prefs.json

# Keep firmware source
!RecalBox_DMD.ino

# PyInstaller / cx_Freeze build scratch (pas la sortie finale des
# installeurs -- tools/dist/ et tools/build/ deja couverts par build//dist/
# plus haut ; ceci est le repertoire scratch specifique a cx_Freeze/
# setup_msi.py) -- synchronise depuis master, ce worktree ne l'avait pas
tools/build_msi_exe/

# Dossier de build/release consolide (merged.bin + scripts RB + outils
# Windows portable/exe/msi) -- genere localement, volumineux (~250 Mo),
# jamais versionne
_release/

# Logs du moniteur serie DMD (tools/DMD_Serial_Monitor.ps1) -- personnels a
# chaque session de debug, jamais versionnes
tools/serial_logs/

# Set "Scores" de progetto-SNAPS (8775 PNG, ~150 Mo) -- asset externe
# telecharge (pS_scores_fullset_288.zip, progettosnaps.net/snapshots/),
# source de reference pour le remplissage manuel de
# verified_default_scores.json (voir DECISIONS.md, 2026-09-05). Re-
# telechargeable a l'identique si perdu -- jamais versionne.
tools/hiscore_assets/
